  "sops": [
    {
      "code": "SOP-TS-002",
      "title_key": "sop_ts_002_title",
      "title": "Protocolo de Desincronización de Token Loyalty (Error 403)",
      "category_key": "sop_category_tech_l2",
      "category": "Tech Support L2",
      "owner_key": "owner_tech_l2",
      "sla_minutes": 30,
      "steps": "1. Verificar la identidad del cliente según el procedimiento autorizado. 2. Confirmar el estado de la sesión en la consola de soporte. 3. Invalidar el token vencido y solicitar una nueva sincronización. 4. Guiar al cliente para cerrar y abrir sesión. 5. Confirmar acceso y documentar el resultado."
    },
    {
      "code": "SOP-LOG-001",
      "title_key": "sop_log_001_title",
      "title": "Protocolo de Rastreo Prioritario OMS/SAP (Paquetes Detenidos)",
      "category_key": "sop_category_cs_l1",
      "category": "Customer Support L1",
      "owner_key": "owner_logistics",
      "sla_minutes": 120,
      "steps": "1. Verificar el número de pedido en OMS. 2. Consultar el estado del transportador y el registro SAP. 3. Si supera 48 horas en preparación, escalar a logística con prioridad. 4. Informar al cliente el siguiente paso y registrar la gestión."
    },
    {
      "code": "SOP-PAY-003",
      "title_key": "sop_pay_003_title",
      "title": "Protocolo de Retención Duplicada en Pagos",
      "category_key": "sop_category_payments",
      "category": "Payments",
      "owner_key": "owner_payments",
      "sla_minutes": 45,
      "steps": "1. Confirmar las dos autorizaciones en la pasarela de pagos. 2. Verificar que la orden no se haya capturado dos veces. 3. Solicitar la liberación de la retención duplicada al equipo de pagos. 4. Informar al cliente el tiempo de reversión (3 a 5 días hábiles). 5. Registrar el caso y confirmar el cierre con el cliente."
    },
    {
      "code": "SOP-RET-004",
      "title_key": "sop_ret_004_title",
      "title": "Protocolo de Reembolsos y Devoluciones",
      "category_key": "sop_category_returns",
      "category": "Returns & Refunds",
      "owner_key": "owner_returns",
      "sla_minutes": 90,
      "steps": "1. Validar el número de pedido y el motivo de la devolución. 2. Confirmar si el artículo está dentro del plazo legal de retracto. 3. Generar la etiqueta de devolución y registrar el motivo. 4. Confirmar el método de reembolso con el cliente. 5. Verificar el abono en el ciclo comprometido y cerrar el caso."
    }
